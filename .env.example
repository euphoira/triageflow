# demo is deterministic, offline, and costs nothing.
TRIAGEFLOW_MODE=demo

# Live: use a model that supports Chat Completions function tools.
# A placeholder is acceptable for local servers that do not require authentication.
TRIAGEFLOW_API_KEY=
TRIAGEFLOW_BASE_URL=https://api.openai.com/v1
TRIAGEFLOW_MODEL=

# Optional absolute path. Only this configured local repository can be selected in the UI.
# Live mode sends selected source excerpts to the configured model provider.
TRIAGEFLOW_REPO=
TRIAGEFLOW_DATA_DIR=.triageflow
TRIAGEFLOW_MAX_STEPS=10
